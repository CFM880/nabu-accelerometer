# Nabu's motion, light, compass, gyroscope, and magnetometer sensors are
# managed by the SLPI SSC firmware. Opt in only on the SDSP FastRPC device.
ACTION=="remove", GOTO="nabu_ssc_sensors_end"
SUBSYSTEM=="misc", KERNEL=="fastrpc-sdsp*", ENV{IIO_SENSOR_PROXY_TYPE}+="ssc-accel ssc-light ssc-compass ssc-gyro ssc-magnetometer", ENV{ACCEL_MOUNT_MATRIX}="-1,0,0;0,-1,0;0,0,1", TAG+="systemd", ENV{SYSTEMD_WANTS}+="iio-sensor-proxy.service"
LABEL="nabu_ssc_sensors_end"
