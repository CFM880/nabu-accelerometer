# Nabu: desktop power defaults for every user.
#
# ambient-enabled: the SSC stack (hexagonrpcd + libssc + iio-sensor-proxy)
# exposes the BU27030 ambient light sensor (sns_bu27030_back, see the sensor
# registry in Android's persist partition), but GNOME only follows it when this
# is set.  A per-user "gsettings set" only writes ~/.config/dconf/user, so a
# fresh install (or another user) would start with auto-brightness off.
#
# sleep-inactive-*-type=suspend: use the real s2idle suspend on the idle
# timeout.  Deep suspend is unavailable (the firmware does not advertise PSCI
# SYSTEM_SUSPEND, so /sys/power/mem_sleep only lists s2idle and "echo mem"
# silently falls back to it), and s2idle costs slightly more than plain
# blanking on this tablet (0.78 W vs 0.63 W measured), but it is the real
# suspend and it is what the desktop is expected to do; the power key then
# wakes the tablet from it.
[org/gnome/settings-daemon/plugins/power]
# nabu-autobrightness (nabu-accelerometer) owns automatic brightness with a
# fixed lux -> backlight curve and applies it through gsd.  GNOME's own
# "relative to the last manual brightness" mapping is switched off, otherwise
# the two fight and a large ambient swing leaves the panel too dark.
ambient-enabled=false
sleep-inactive-ac-type='suspend'
sleep-inactive-battery-type='suspend'
sleep-inactive-ac-timeout=900
sleep-inactive-battery-timeout=900
