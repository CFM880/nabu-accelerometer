# Nabu: desktop power defaults for every user.
#
# ambient-enabled: the SSC stack (hexagonrpcd + libssc + iio-sensor-proxy)
# exposes the TCS3701 ambient light sensor, but GNOME only follows it when this
# is set.  A per-user "gsettings set" only writes ~/.config/dconf/user, so a
# fresh install (or another user) would start with auto-brightness off.
#
# sleep-inactive-*-type=nothing: suspend is not worth it on this tablet yet.
# Measured with the screen blanked: 0.63 W idle, but 0.78 W while suspended in
# s2idle - and deep suspend is unavailable because the firmware does not
# advertise PSCI SYSTEM_SUSPEND (/sys/power/mem_sleep only lists s2idle, "mem"
# silently falls back to it).  Blanking alone is therefore both cheaper and
# safer: nothing can fail to wake, and the power key never means "suspend"
# when the screen is already off.
[org/gnome/settings-daemon/plugins/power]
ambient-enabled=true
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'
sleep-inactive-ac-timeout=900
sleep-inactive-battery-timeout=900
