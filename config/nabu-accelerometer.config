# LSM6DSO IMU configuration fragment for Xiaomi Pad 5 (nabu)
CONFIG_IIO=y
CONFIG_IIO_ST_LSM6DSX=m
CONFIG_IIO_ST_LSM6DSX_SPI=m
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_QCOM_GENI=m

# Bring up a CDC ACM gadget without waiting for userspace so ttyGS0 is ready
# before udev probes the SSC diagnostic module.  The base nabu config already
# enables USB gadget serial console support; keep the explicit dependency here
# so this diagnostic remains self-contained.
CONFIG_USB_GADGET=y
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
