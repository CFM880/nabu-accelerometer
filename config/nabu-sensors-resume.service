[Unit]
Description=Recover the Nabu SLPI sensor stack after resume
Documentation=file:///usr/local/share/doc/nabu-accelerometer/DEVELOPMENT.md
After=suspend.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/nabu-sensors-resume

[Install]
WantedBy=suspend.target
