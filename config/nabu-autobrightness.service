[Unit]
Description=Fixed-curve automatic brightness (nabu)
Documentation=file:///usr/local/share/doc/nabu-accelerometer/DEVELOPMENT.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/nabu-autobrightness
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
