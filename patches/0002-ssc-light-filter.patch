 static void
+publish_light (SensorDevice *sensor_device)
+{
+	DrvData *drv_data = sensor_device->priv;
+	LightReadings readings = {
+		.level = drv_data->filter.published,
+		.uses_lux = TRUE,
+	};
+
+	sensor_device->callback_func (sensor_device, &readings, sensor_device->user_data);
+}
+
+static gboolean
+filter_tick (gpointer user_data)
+{
+	SensorDevice *sensor_device = user_data;
+	DrvData *drv_data = sensor_device->priv;
+
+	if (nabu_light_filter_poll (&drv_data->filter, g_get_monotonic_time ()))
+		publish_light (sensor_device);
+	return G_SOURCE_CONTINUE;
+}
