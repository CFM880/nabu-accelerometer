 static void
+gyro_changed_func (SensorDevice *sensor_device,
+		   gpointer      readings_data,
+		   gpointer      user_data)
+{
+	SensorData *data = user_data;
+	AngularVelocityReadings *readings = (AngularVelocityReadings *) readings_data;
+	gint64 now;
+
+	data->previous_gyro[0] = readings->x;
+	data->previous_gyro[1] = readings->y;
+	data->previous_gyro[2] = readings->z;
+
+	maybe_notify_sensor_startup_finished (data, DRIVER_TYPE_GYRO);
+
+	/* Gyroscopes report far faster than any consumer needs; coalesce D-Bus
+	 * updates to at most one every 20ms.  previous_gyro_emit starts at 0 so
+	 * the first reading always goes out. */
+	now = g_get_monotonic_time ();
+	if (now - data->previous_gyro_emit < 20 * 1000)
+		return;
+
+	data->previous_gyro_emit = now;
+	send_dbus_event (data, PROP_GYROSCOPE_READINGS);
+}
+
+static void
+magnetometer_changed_func (SensorDevice *sensor_device,
+			   gpointer      readings_data,
+			   gpointer      user_data)
+{
+	SensorData *data = user_data;
+	MagnetometerReadings *readings = (MagnetometerReadings *) readings_data;
+
+	if (data->previous_magnetometer[0] != readings->x ||
+	    data->previous_magnetometer[1] != readings->y ||
+	    data->previous_magnetometer[2] != readings->z) {
+		data->previous_magnetometer[0] = readings->x;
+		data->previous_magnetometer[1] = readings->y;
+		data->previous_magnetometer[2] = readings->z;
+
+		send_dbus_event (data, PROP_MAGNETOMETER_READINGS);
+	}
+
+	maybe_notify_sensor_startup_finished (data, DRIVER_TYPE_MAGNETOMETER);
+}
