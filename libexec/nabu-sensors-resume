#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# Recover the Nabu SLPI sensor userspace after resume.
#
# The SLPI can crash on resume, which stops hexagonrpcd and crashes
# iio-sensor-proxy.  Both units have Restart=on-failure, so they recover from
# a crash by themselves; this hook only starts a unit that stopped cleanly
# (status 0) and was therefore not restarted.  "start" is a no-op on a unit
# that is already running, so a clean resume (the SLPI survived) leaves
# Mutter's accelerometer claim and panel rotation untouched.
#
# Note: Mutter does not re-claim the accelerometer after the proxy is
# restarted, so panel rotation still needs a fresh login when the SLPI
# crashed; the light/compass data path recovers here.
set -u

systemctl start hexagonrpcd.service iio-sensor-proxy.service || true
